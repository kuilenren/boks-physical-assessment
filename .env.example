NODE_ENV=development
BOKS_RUNTIME_ENV=development
API_PORT=3000
BOKS_ENABLE_DEV_AUTH=true
BOKS_HTTP_ACCESS_LOG=true

# 存储模式：json (dev) / postgres (staging/prod)
BOKS_STORAGE_MODE=json
BOKS_DATABASE_URL=postgresql://boks:boks-local-only@localhost:5433/boks
BOKS_DATABASE_USER=boks
BOKS_DATABASE_PASSWORD=boks-local-only
BOKS_DATABASE_SSL=false
BOKS_DATABASE_POOL_MAX=10

# Redis 限流 / 幂等 / 缓存
BOKS_REDIS_URL=redis://localhost:6379

# CORS / 鉴权
BOKS_CORS_ORIGIN=http://localhost:3000
BOKS_ADMIN_TOKEN=local-dev-token
BOKS_ADMIN_REVIEWERS=reviewer-one,reviewer-two
BOKS_ADMIN_MFA_SECRET=JBSWY3DPEHPK3PXP

# 对象存储（本地资产）
BOKS_OBJECT_STORAGE_BUCKET=boks-private
BOKS_OBJECT_STORAGE_ENDPOINT=
BOKS_OBJECT_STORAGE_REGION=auto
BOKS_OBJECT_STORAGE_ACCESS_KEY=
BOKS_OBJECT_STORAGE_SECRET_KEY=
BOKS_OBJECT_STORAGE_SESSION_TOKEN=
BOKS_OBJECT_STORAGE_KMS_KEY_ID=
BOKS_OBJECT_STORAGE_LIFECYCLE_DAYS=30
BOKS_ASSET_DIR=./runtime/posture-assets

# 微信登录（生产配置）
BOKS_WECHAT_APP_ID=
BOKS_WECHAT_APP_SECRET=

# 手机号认证
BOKS_PHONE_AUTH_URL=
BOKS_PHONE_AUTH_TOKEN=

# AI 服务（流式 SSE 端点）
BOKS_AI_SERVICE_URL=http://127.0.0.1:8001

# LLM providers（OpenAI 兼容）
BOKS_AI_PROVIDER=deepseek
BOKS_AI_LLM_BASE_URL=https://api.deepseek.com
BOKS_AI_LLM_API_KEY=
BOKS_AI_LLM_MODEL=deepseek-chat

# 备用 LLM provider
BOKS_AI_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
BOKS_AI_MINIMAX_API_KEY=
BOKS_AI_MINIMAX_MODEL=MiniMax-Text-01

# Embedding（sentence-transformers）
BOKS_EMBED_MODEL=intfloat/multilingual-e5-base
BOKS_EMBED_CACHE=./runtime/embed-cache.db

# KMS 本地（生产应替换为 Vault/HSM）
BOKS_KEK_ID=kek-local-v1
BOKS_KEK_BASE64=
BOKS_HMAC_KEY=

# 知识库同步
BOKS_KNOWLEDGE_SYNC_INTERVAL_MS=0

# 限流开关（仅开发用，生产禁用）
BOKS_RATE_LIMIT_DISABLED=false