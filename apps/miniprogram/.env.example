# WeChat mini-program build-time environment variables.
# These MUST be defined in one of: .env / .env.local / .env.development / .env.production
# (copy this file to .env.development for `pnpm dev:weapp`, or .env.production for `pnpm build:weapp`).
# Only variables prefixed with TARO_APP_ are inlined into the compiled bundle by Taro's DefinePlugin.

# API base URL (development default)
TARO_APP_API_BASE_URL=http://127.0.0.1:3000/v1

# Optional pre-configured auth token injected in non-production builds
TARO_APP_API_TOKEN=
