{
  "description": "BOKS 儿童体测与体态观察小程序",
  "compileType": "miniprogram",
  "libVersion": "3.8.0",
  "appid": "touristappid",
  "projectname": "boks-miniprogram",
  "miniprogramRoot": "./dist",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".swc"
      },
      {
        "type": "folder",
        "value": "src"
      },
      {
        "type": "folder",
        "value": "config"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "file",
        "value": "tsconfig.json"
      },
      {
        "type": "file",
        "value": "babel.config.js"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ]
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "checkInvalidKey": true,
    "checkSiteMap": false
  },
  "condition": {}
}
