# BOKS API 服务器环境变量
# 复制此文件为 .env 并根据实际情况修改

# 运行环境 (development | staging | production)
BOKS_RUNTIME_ENV=development

# 数据库连接 (PostgreSQL)
BOKS_DATABASE_URL=postgres://boks:boks-local-only@localhost:5432/boks

# 管理员令牌 (生产环境必须设置)
BOKS_ADMIN_TOKEN=replace-me

# 管理员审核员列表 (逗号分隔，生产环境至少2人)
BOKS_ADMIN_REVIEWERS=reviewer1,reviewer2

# 管理员 MFA 密钥 (Base32，生产环境至少16位)
BOKS_ADMIN_MFA_SECRET=replace-me

# 对象存储 (生产环境必须使用 Postgres 存储模式)
BOKS_STORAGE_MODE=postgres
BOKS_OBJECT_STORAGE_BUCKET=boks-assets
BOKS_OBJECT_STORAGE_ACCESS_KEY=replace-me
BOKS_OBJECT_STORAGE_SECRET_KEY=replace-me
BOKS_OBJECT_STORAGE_ENDPOINT=https://storage.example.com
BOKS_OBJECT_STORAGE_LIFECYCLE_DAYS=30

# 微信小程序配置
BOKS_WECHAT_APP_ID=your-wechat-app-id
BOKS_WECHAT_APP_SECRET=your-wechat-app-secret

# 手机号登录配置 (可选)
BOKS_PHONE_AUTH_URL=
BOKS_PHONE_AUTH_TOKEN=

# 生产环境必须配置
BOKS_CORS_ORIGIN=https://your-domain.com
BOKS_PUBLIC_HOST=your-domain.com

# API 端口
API_PORT=3000

# 禁用开发模式认证 (生产环境必须为 false)
BOKS_ENABLE_DEV_AUTH=false
