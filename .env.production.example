# ==============================================================
# BOKS 生产环境模板（.env.production.example）
# 复制为 .env 并填入真实值。禁止直接使用本文件的示例值！
#
# 服务器：腾讯云 广州
#   公网 IPv4  152.136.218.37
#   内网 IPv4  10.2.0.10
#   IPv6       2402:4e00:c050:1f00:24e0:1ddc:da5e:0
# 域名：api.boks-ai.com.cn（API/小程序后台）、www.boks-ai.com.cn（小程序前端 + 官网）、
#      boks-ai.com.cn（根域，跳转 www）、ai.boks-ai.com.cn（AI 服务）
# ==============================================================

NODE_ENV=production
BOKS_RUNTIME_ENV=production
API_PORT=3000
# 生产环境严禁启用开发登录
BOKS_ENABLE_DEV_AUTH=false
BOKS_HTTP_ACCESS_LOG=true

# 存储模式：生产必须为 postgres
BOKS_STORAGE_MODE=postgres
BOKS_DATABASE_URL=postgresql://boks:CHANGE_ME@10.2.0.10:5432/boks
BOKS_DATABASE_USER=boks
BOKS_DATABASE_PASSWORD=CHANGE_ME
BOKS_DATABASE_SSL=true
BOKS_DATABASE_POOL_MAX=10

# Redis（限流 / 幂等 / 缓存）
BOKS_REDIS_URL=redis://10.2.0.10:6379

# CORS / 鉴权 —— 以下全部必须替换为真实生产密钥
BOKS_CORS_ORIGIN=https://www.boks-ai.com.cn,https://api.boks-ai.com.cn
BOKS_ADMIN_TOKEN=CHANGE_ME_RANDOM_64_HEX
BOKS_ADMIN_REVIEWERS=real-reviewer-one,real-reviewer-two
BOKS_ADMIN_MFA_SECRET=CHANGE_ME_BASE32_16PLUS

# 对象存储（腾讯云 COS，S3 兼容）
BOKS_OBJECT_STORAGE_BUCKET=CHANGE_ME
BOKS_OBJECT_STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
BOKS_OBJECT_STORAGE_REGION=ap-guangzhou
BOKS_OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
BOKS_OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
BOKS_OBJECT_STORAGE_SESSION_TOKEN=
BOKS_OBJECT_STORAGE_KMS_KEY_ID=
BOKS_OBJECT_STORAGE_LIFECYCLE_DAYS=30
BOKS_ASSET_DIR=./runtime/posture-assets

# 微信登录（小程序 AppID wxabef59d1d9eec429）
BOKS_WECHAT_APP_ID=wxabef59d1d9eec429
BOKS_WECHAT_APP_SECRET=CHANGE_ME

# 手机号认证（短信服务商 HTTPS 端点）
BOKS_PHONE_AUTH_URL=https://sms.example.com
BOKS_PHONE_AUTH_TOKEN=CHANGE_ME

# AI 服务（必须 HTTPS）
BOKS_AI_SERVICE_URL=https://ai.boks-ai.com.cn

# LLM providers（OpenAI 兼容）
BOKS_AI_PROVIDER=deepseek
BOKS_AI_LLM_BASE_URL=https://api.deepseek.com
BOKS_AI_LLM_API_KEY=CHANGE_ME
BOKS_AI_LLM_MODEL=deepseek-chat

# 备用 LLM provider
BOKS_AI_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
BOKS_AI_MINIMAX_API_KEY=CHANGE_ME
BOKS_AI_MINIMAX_MODEL=MiniMax-Text-01

# Embedding（sentence-transformers）
BOKS_EMBED_MODEL=intfloat/multilingual-e5-base
BOKS_EMBED_CACHE=./runtime/embed-cache.db

# KMS（生产应使用 Vault/HSM/腾讯云 KMS）
BOKS_KEK_ID=CHANGE_ME
BOKS_KEK_BASE64=CHANGE_ME
BOKS_HMAC_KEY=CHANGE_ME

# 知识库同步
BOKS_KNOWLEDGE_SYNC_INTERVAL_MS=3600000

# 限流开关（生产必须为 false）
BOKS_RATE_LIMIT_DISABLED=false
